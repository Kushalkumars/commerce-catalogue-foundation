# Copy to .env in this folder if you want to override the defaults.
# The app runs without this file.

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Fake Store is the only product source in this proof of concept.
FAKE_STORE_BASE_URL=https://fakestoreapi.com
CATALOGUE_CACHE_SECONDS=60

# The entrepreneur's chosen home-page products, in display order.
FEATURED_PRODUCT_IDS=1,2,3,4,5

# How many highest-rated products to lift out on a category page.
TOP_RATED_PER_CATEGORY=3

# Where enquiry emails are addressed. Nothing is sent over SMTP.
SALES_INBOX=sales@example.com

# Local stand-in for the sales mailbox. Turn off when a real provider is wired in.
ENABLE_DEV_INBOX=true
